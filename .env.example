# Copy this file to .env, then fill it in locally. Do not share or commit .env.
BUFFER_API_KEY=
BUFFER_CHANNELS=instagram:CHANNEL_ID,tiktok:CHANNEL_ID,youtube:CHANNEL_ID
# Public HTTPS base URL that serves the contents of the ready/ folder.
PUBLIC_MEDIA_BASE_URL=
# Set to true only if you accept that scheduled video files are accessible by URL
# before Buffer publishes them. Buffer fetches media from a public URL at post time.
ALLOW_PUBLIC_MEDIA=false
